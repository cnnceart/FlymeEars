<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <application
        android:label="FlymeEars"
        android:icon="@android:drawable/ic_menu_compass"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="FlymeEars" />

        <!-- 桌面图标放在 alias 上，便于运行期隐藏/恢复。 -->
        <activity-alias
            android:name=".ui.Launcher"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:label="FlymeEars"
            android:icon="@android:drawable/ic_menu_compass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 隐藏桌面图标后的入口：快捷设置磁贴。 -->
        <service
            android:name=".ui.EncoTileService"
            android:exported="true"
            android:label="FlymeEars"
            android:icon="@android:drawable/ic_menu_compass"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          设备中心卡片（Android Device Controls）。实测 Flyme 设备中心对 provider
          加载有自己的门控（魅族自家 mznfcpay 也超时），卡片无法出现，故暂时停用；
          将来启用时注意不要与 SystemUI 会话同时持有 RFCOMM。

        <service
            android:name=".control.EncoControlService"
            android:exported="true"
            android:label="FlymeEars"
            android:permission="android.permission.BIND_CONTROLS">
            <intent-filter>
                <action android:name="android.service.controls.ControlsProviderService" />
            </intent-filter>
        </service>
        -->

        <!-- 控制中心「降噪」磁贴 -->
        <service
            android:name=".ui.AncTileService"
            android:exported="true"
            android:label="降噪"
            android:icon="@android:drawable/ic_lock_silent_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
            android:name=".popup.ArtProvider"
            android:authorities="dev.flymeears.art"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
